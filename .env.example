# ============================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to .env.local for local development
# Set these values in Netlify dashboard for production
# ============================================

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME="PHOENIXX SmartBuild"

# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=your-sanity-read-token

# Revalidation
# Required: /api/revalidate returns 503 when this is unset rather than allowing
# unauthenticated revalidation.
REVALIDATION_SECRET=your-revalidation-secret-here

# IndexNow
# The key itself is public (published at /<key>.txt for domain verification).
INDEXNOW_KEY=2f9deb3c91c64f92b7980e9c2bd6d948
# Authenticates POST /api/indexnow. Falls back to REVALIDATION_SECRET if unset.
INDEXNOW_TRIGGER_SECRET=your-indexnow-trigger-secret-here

# Authenticates POST /api/prices?action=refresh, which re-reads the Google Sheet.
# Falls back to REVALIDATION_SECRET if unset.
PRICE_REFRESH_SECRET=your-price-refresh-secret-here

# Analytics - Google Analytics 4 (required for tracking)
# Get your Measurement ID from Google Analytics 4 Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-L19YN99F03
